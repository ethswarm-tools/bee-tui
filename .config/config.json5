{
  // List of Bee nodes the cockpit can attach to. Multi-node UX is v0.4;
  // for now the first entry (or the one with default=true) is used.
  "nodes": [
    {
      "name": "local",
      "url": "http://localhost:1633",
      // "token": "@env:BEE_TOKEN_LOCAL",  // for restricted-mode nodes
      "default": true,
    },
  ],

  "keybindings": {
    "Home": {
      // Plain `q` is intercepted in src/app.rs and requires a
      // double-tap within ~1.5s before quitting; only Ctrl+C and
      // Ctrl+D are wired here as immediate-quit escape hatches.
      "<Ctrl-d>": "Quit",
      "<Ctrl-c>": "Quit",
      "<Ctrl-z>": "Suspend"
    },
  }
}
